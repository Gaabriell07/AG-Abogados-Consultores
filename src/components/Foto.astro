---
// Muestra la imagen si existe en /public/images; si no, un recuadro
// gris con el nombre del archivo que hay que subir.
interface Props {
  src: string;
  alt?: string;
  class?: string;
  eager?: boolean;
}
const { src, alt = '', class: cls = '', eager = false } = Astro.props;
const archivo = src.split('/').pop();
const url = import.meta.env.BASE_URL.replace(/\/$/, '') + src;
---
<div class={`foto ${cls}`} data-archivo={archivo}>
  <img
    src={url}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    onerror="this.remove()"
  />
</div>

<style>
  .foto {
    position: relative;
    overflow: hidden;
    background: var(--light-green);
    width: 100%;
    height: 100%;
  }
  .foto::before {
    content: 'Imagen: ' attr(data-archivo);
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font: 0.8rem var(--sans);
    letter-spacing: 0.05em;
    color: var(--green);
    opacity: 0.6;
  }
  img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
